generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id            String         @id @default(cuid())
  slug          String         @unique
  titleRu       String
  titleKk       String
  descRu        String
  descKk        String
  category      String         @default("Учёба")
  ministry      String         @default("general")
  date          DateTime
  location      String
  image         String         @default("")
  maxSeats      Int            @default(100)
  programRu     String         @default("")
  programKk     String         @default("")
  gallery       String         @default("[]")
  archived      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
}

model Registration {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  grade     String
  phone     String   @default("")
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Member {
  id             String   @id @default(cuid())
  login          String   @unique
  password       String   @default("parliament2025")
  ministry       String   @default("general")
  ministryNameRu String   @default("Президиум Парламента")
  ministryNameKk String   @default("Парламент Төралқасы")
  nameRu         String   @default("")
  nameKk         String   @default("")
  grade          String   @default("")
  roleRu         String
  roleKk         String
  quoteRu        String   @default("")
  quoteKk        String   @default("")
  bioRu          String   @default("")
  bioKk          String   @default("")
  assistants     String   @default("[]")
  photo          String   @default("")
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TimelineItem {
  id        String   @id @default(cuid())
  titleRu   String
  titleKk   String
  descRu    String   @default("")
  descKk    String   @default("")
  ministry  String   @default("general")
  month     Int
  year      Int      @default(2025)
  icon      String   @default("📌")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model News {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleRu   String
  titleKk   String
  contentRu String
  contentKk String
  excerpt   String   @default("")
  image     String   @default("")
  ministry  String   @default("general")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Poll {
  id         String       @id @default(cuid())
  questionRu String
  questionKk String
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  options    PollOption[]
}

model PollOption {
  id      String @id @default(cuid())
  pollId  String
  textRu  String
  textKk  String
  poll    Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes   Vote[]
}

model Vote {
  id        String     @id @default(cuid())
  optionId  String
  ip        String
  createdAt DateTime   @default(now())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
}

model Suggestion {
  id        String   @id @default(cuid())
  text      String
  author    String   @default("Аноним")
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Appeal {
  id        String   @id @default(cuid())
  type      String
  ministry  String   @default("general")
  name      String   @default("")
  grade     String   @default("")
  text      String
  anonymous Boolean  @default(false)
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stat {
  id      String @id @default(cuid())
  key     String @unique
  value   Int    @default(0)
  labelRu String @default("")
  labelKk String @default("")
}
